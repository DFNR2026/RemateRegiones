# Credenciales y configuración local
config.py

# Datos de trabajo (cambian cada ejecución)
causas_antes.json
causas_despues.json
tasacion_cache.db

# Carpetas de datos (contenido excluido, .gitkeep preservado)
Diarios/*
!Diarios/.gitkeep
Descargas/*
!Descargas/.gitkeep

# Reportes generados
TEST_*.docx

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Playwright
.playwright_profile/
playwright_profile/

# IDE
.vscode/
.idea/
.claude/

# OS
.DS_Store
Thumbs.db
desktop.ini

# OCR (ya no se usa con DOCX)
.tessdata/

# Backups
backup_*/

# === Basura tecnica voluminosa que NO va al repo ===

# Perfiles Chrome (workers) — se regeneran
.chrome-profile/
.chrome-profile-w*/

# Logs (regenerables, a cualquier profundidad)
**/logs/
logs liqui/

# Temporales del filtrador
temp_workers/
temp_workers_m2/

# HTMLs de auditoria de runs (regenerables)
audit_html/

# PDFs de actas descargados (regenerables)
Descargas/

# Backups automaticos con timestamp
*_backup_*.xlsx
*_pretest_*.xlsx
*.backup_*

# Patches/diffs temporales
tmp_*.patch
